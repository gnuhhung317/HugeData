# kafka configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=traffic
KAFKA_GROUP_ID=spark-realtime-group
KAFKA_STARTING_OFFSETS=earliest


# BATCH ==========================================
# hdfs configuration
HDFS_NAMENODE=hdfs://hdfs-namenode:8020

# checkpoint locations
CHECKPOINT_BASE=/app/data/checkpoint


# cassandra configuration
CASSANDRA_HOST=cassandra.hugedata.svc.cluster.local


# REALTIME =======================================
# timescaledb configuration
TIMESCALEDB_URL=jdbc:postgresql://timescaledb.hugedata.svc.cluster.local:5432/traffic
TIMESCALEDB_USER=postgres
TIMESCALEDB_PASSWORD=postgres
TIMESCALEDB_TABLE=traffic_metrics

# spark streaming triggers
TRIGGER_TIMESCALE=10 seconds
TRIGGER_CONSOLE=5 seconds

# database write retry settings
DB_WRITE_MAX_RETRIES=3
DB_WRITE_BACKOFF_SEC=2